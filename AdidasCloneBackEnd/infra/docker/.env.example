# Copy to infra/docker/.env.local, use unique local secrets; never commit .env.local.
V2_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
V2_RABBITMQ_USER=v2_local_user
V2_RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
V2_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Identity: generate a fresh matching RSA key pair; never use these placeholders at runtime.
V2_CUSTOMER_INTERNAL_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
V2_IDENTITY_JWT_PRIVATE_KEY_B64=BASE64_OF_PRIVATE_PEM
V2_IDENTITY_JWT_PUBLIC_KEY_B64=BASE64_OF_PUBLIC_PEM

# Notification: keep the consumer disabled until SMTP is configured and verified.
V2_NOTIFICATION_RMQ_ENABLED=false
V2_NOTIFICATION_SMTP_HOST=
V2_NOTIFICATION_SMTP_PORT=587
V2_NOTIFICATION_SMTP_SECURE=false
V2_NOTIFICATION_SMTP_USER=
V2_NOTIFICATION_SMTP_PASSWORD=
V2_NOTIFICATION_EMAIL_FROM=no-reply@example.invalid
V2_NOTIFICATION_PUBLIC_WEB_URL=http://localhost:3000
V2_NOTIFICATION_VERIFY_SMTP=false
