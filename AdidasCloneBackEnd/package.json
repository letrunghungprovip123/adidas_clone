{
  "name": "adidas-clone-v2-backend",
  "version": "0.1.0",
  "private": true,
  "description": "V2 NestJS monorepo foundation: no V1 business migrations",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint apps libs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start:gateway": "node dist/apps/api-gateway/src/main.js",
    "start:identity": "node dist/apps/identity-service/src/main.js",
    "start:customer": "node dist/apps/customer-service/src/main.js",
    "start:catalog": "node dist/apps/catalog-service/src/main.js",
    "start:inventory": "node dist/apps/inventory-service/src/main.js",
    "start:order": "node dist/apps/order-service/src/main.js",
    "start:payment": "node dist/apps/payment-service/src/main.js",
    "start:promotion": "node dist/apps/promotion-service/src/main.js",
    "start:notification": "node dist/apps/notification-service/src/main.js",
    "smoke:foundation": "node scripts/verify-foundation-smoke.mjs",
    "migrate:inventory": "node scripts/phase2/migrate-inventory.mjs",
    "test:inventory": "node --test tests/inventory.integration.mjs",
    "seed:inventory:check": "node scripts/phase2/import-seed-v1.mjs --check",
    "test:inventory:rmq": "node --test tests/inventory.rabbit.integration.mjs",
    "migrate:catalog": "node scripts/phase3/migrate-catalog.mjs",
    "seed:catalog:check": "node scripts/phase3/seed-catalog.mjs --check",
    "seed:catalog": "node scripts/phase3/import-catalog.mjs",
    "test:catalog": "node --test tests/catalog.integration.mjs",
    "test:catalog:rmq": "node --test tests/catalog.rabbit.integration.mjs",
    "test:catalog:es": "node --test tests/catalog.search.integration.mjs",
    "migrate:identity": "node scripts/phase5/migrate-identity.mjs",
    "seed:identity:check": "node scripts/phase5/seed-identity.mjs --check",
    "seed:identity": "node scripts/phase5/seed-identity.mjs",
    "seed:identity:sql": "node scripts/phase5/seed-identity.mjs --sql",
    "test:identity": "node --test tests/identity.integration.mjs",
    "migrate:customer": "node scripts/phase4/migrate-customer.mjs",
    "seed:customer:check": "node scripts/phase4/seed-customer.mjs --check",
    "seed:customer": "node scripts/phase4/import-customer.mjs",
    "test:customer": "node --test tests/customer.integration.mjs",
    "test:customer:rmq": "node --test tests/customer.rabbit.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "pg": "8.23.1",
    "amqplib": "0.10.9",
    "amqp-connection-manager": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "eslint": "9.39.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "@types/pg": "8.23.1",
    "@types/amqplib": "0.10.7"
  },
  "overrides": {
    "js-yaml": "5.4.1"
  }
}
